# Database (Vercel Postgres — auto-set when you add a Postgres store in Vercel dashboard)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Anthropic
ANTHROPIC_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Admin auth (iron-session)
SESSION_SECRET=change_this_to_a_random_32_char_string_minimum

# Admin password (default for dev)
ADMIN_PASSWORD=admin123

# App URL (used in Slack messages)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron secret (used to authenticate Vercel cron requests)
CRON_SECRET=change_this_to_a_random_string
